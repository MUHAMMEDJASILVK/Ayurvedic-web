# ==============================================================
# Kerala Ayurveda Portal - Environment Configuration
# ==============================================================

DEBUG=True
SECRET_KEY=kerala-ayurveda-store-super-secret-key-2026

# Email Settings (for real email OTP sending)
# To send real emails with OTP to user's registered inbox:
# 1. For Gmail: Use your Gmail and 16-character Google "App Password"
#    (Manage Google Account -> Security -> 2-Step Verification -> App Passwords)
# 2. Uncomment and fill the lines below:
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_character_app_password
DEFAULT_FROM_EMAIL="Kerala Ayurveda Store <your_email@gmail.com>"

# SMS Gateway (Optional: Fast2SMS, Twilio, etc.)
# If left empty, SMS OTP is safely logged in Django terminal & verified normally
SMS_API_KEY=
SMS_SENDER_ID=AYURVD
